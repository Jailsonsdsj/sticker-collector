{
  "name": "sticker-collector",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build": "pnpm -r --filter=./packages/web run build",
    "test": "vitest run",
    "typecheck": "tsc -b && tsc -b packages/api/test/tsconfig.json",
    "typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json",
    "lint": "biome ci .",
    "lint:tokens": "bash scripts/check-tokens.sh",
    "types": "wrangler types packages/api/src/worker-configuration.d.ts",
    "db:generate": "pnpm --filter @sticker-collector/api exec drizzle-kit generate",
    "seed": "bash scripts/seed.sh",
    "provision": "tsx scripts/provision-user.mjs",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "e2e:ui": "playwright test --config e2e/playwright.config.ts --ui"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@playwright/test": "^1.62.0",
    "@sticker-collector/shared": "workspace:*",
    "@types/node": "^24.13.3",
    "jpeg-js": "^0.4.4",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
