node_modules/
dist/
.wrangler/
.dev.vars
*.local
.DS_Store

# TypeScript incremental build cache — a committed cache lies to `tsc -b` on a
# fresh clone (it skips a build whose output — dist/ — isn't checked in → TS6305).
*.tsbuildinfo

# Claude Design handoff bundle: specs are committed, binary assets are not
design/**/*.png
design/**/*.jpg
design/**/*.webp
docs/design
docs/design/**/*.png
docs/design/**/*.jpg
docs/design/**/*.webp


# Playwright output — reports, traces and screenshots are per-run artifacts.
/playwright-report/
/test-results/
/blob-report/

# Playwright signed-in session, recreated on every run.
/e2e/.auth/
